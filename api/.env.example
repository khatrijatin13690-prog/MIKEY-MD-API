# Server
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5500

# Generate a long random secret for your own API clients.
API_KEY=replace_with_a_long_random_api_key

# PostgreSQL connection string from Railway PostgreSQL service.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Set to true only if your database provider requires TLS.
PG_SSL=true

# Meta WhatsApp Business Cloud API
WHATSAPP_TOKEN=your_meta_access_token
PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=make_your_own_webhook_verify_token
META_APP_SECRET=your_meta_app_secret
GRAPH_API_VERSION=vXX.X
